def show_beats(beats: list[dict]):
    icons = {"setup": "●", "punchline": "★", "closer": "■", "tag": "◆"}
    for b in beats:
        c = GREEN if b["word_count"] < 8 else YELLOW if b["word_count"] < 15 else DIM
        print(f"  {BOLD}{icons.get(b['type'], '●')} {b['id']}{RESET} "
              f"{b['type']:<10} {c}{b['text'][:58]}{RESET} {DIM}+{b['pause_after_ms']}ms{RESET}")
    tot = sum(b["pause_after_ms"] for b in beats)
    print(f"  {DIM}{'─' * 56}{RESET}")
    print(f"  {DIM}{len(beats)} beats | {sum(b['word_count'] for b in beats)} words | "
          f"~{(tot + len(beats) * 2000) // 1000}s{RESET}")


def do_premise(premise: str, voice: str, no_play: bool) -> list[dict]:
    print(f"\n  {DIM}writing...{RESET}")
    data = llm_minute(premise) or fallback_minute(premise)
    print(f"\n  {BOLD}{data.get('name', '')}{RESET} {DIM}"
          f"{data.get('species', '')} · {data.get('vibe', '')}{RESET}")
    print(f"  {DIM}{data.get('premise', '')}{RESET}\n")
    beats = detect_beats(data["minute"])
    show_beats(beats)
    if not no_play:
        print(f"\n  {DIM}composing...{RESET}")
        path = compose(beats, voice)
        print(f"  {GREEN}playing ({path.name}){RESET}\n")
        play(path)
    return beats


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("-")]
    no_play = "--no-play" in sys.argv[1:]
    voice = "en-US-AriaNeural"
    for a in sys.argv[1:]:
        if a.startswith("--voice="):
            voice = a.split("=", 1)[1]

    banner()
    beats: list[dict] = []

    if args:
        beats = do_premise(" ".join(args), voice, no_play)

    while True:
        try:
            line = input(f"\n{MAGENTA}come on then funny bones > {RESET}").strip()
        except (EOFError, KeyboardInterrupt):
            print(f"\n{DIM}goodnight.{RESET}")
            return
        if not line:
            continue
        cmd, _, rest = line.partition(" ")
        cmd = cmd.lower()

        if cmd in ("quit", "q", "exit"):
            print(f"{DIM}goodnight.{RESET}")
            return
        if cmd == "help":
            print(f"  {DIM}type a premise to generate · edit <id> <text> · pause <id> <ms> · "
                  f"play · play <id> · beats · voice <name> · quit{RESET}")
            continue
        if cmd == "beats":
            show_beats(beats) if beats else print(f"  {DIM}no beats yet — give me a premise{RESET}")
            continue
        if cmd == "play" and not rest:
            if not beats:
                print(f"  {DIM}nothing to play — give me a premise first{RESET}")
                continue
            print(f"  {DIM}composing...{RESET}")
            play(compose(beats, voice))
            continue
        if cmd == "play" and rest:
            hit = [b for b in beats if b["id"] == rest]
            if not hit:
                print(f"  {RED}no beat {rest}{RESET}")
                continue
            b = hit[0]
            play(compose([b], voice))
            continue
        if cmd == "edit":
            bid, _, text = rest.partition(" ")
            for b in beats:
                if b["id"] == bid and text:
                    b["text"] = text
                    b["word_count"] = len(text.split())
                    print(f"  updated {bid} — type 'play' to hear it")
                    break
            else:
                print(f"  {RED}usage: edit <id> <new text>{RESET}")
            continue
        if cmd == "pause":
            parts = rest.split()
            if len(parts) == 2:
                for b in beats:
                    if b["id"] == parts[0]:
                        try:
                            b["pause_after_ms"] = max(0, int(parts[1]))
                            print(f"  {b['id']} → {b['pause_after_ms']}ms")
                        except ValueError:
                            print(f"  {RED}ms must be a number{RESET}")
                        break
                else:
                    print(f"  {RED}no beat {parts[0]}{RESET}")
            else:
                print(f"  {RED}usage: pause <id> <ms>{RESET}")
            continue
        if cmd == "voice":
            if rest:
                voice = rest
                print(f"  voice → {voice}")
            else:
                print(f"  current: {voice}")
            continue
        # anything else = new premise
        beats = do_premise(line, voice, no_play)


if __name__ == "__main__":
    main()
