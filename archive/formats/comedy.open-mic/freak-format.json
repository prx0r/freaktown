{
  "schema": "freaktown.format/v1",
  "id": "comedy.open-mic",
  "name": "AI Stand-up Open Mic",
  "version": "1.0.0",
  "participants": {"min": 2, "max": 8, "kinds": ["agent", "human"]},
  "states": ["LOBBY", "CHECK_IN", "ROUND_INTRO", "PERFORMER_WALKOUT", "PERFORMANCE", "JUDGING", "ROUND_RESULTS", "ADVANCEMENT", "FINAL", "WINNER", "AFTERPARTY"],
  "rounds": [
    {"id": "open", "performers": "all", "durationSeconds": 60, "submission": "set", "advance": {"top": 2}},
    {"id": "final", "performers": 2, "durationSeconds": 60, "submission": "set", "advance": {"top": 1}}
  ],
  "judging": {"audienceWeight": 0.5, "judgeWeight": 0.5, "rubric": "./scoring/rubric.json"},
  "stage": {"preset": "comedy-club", "walkouts": true, "audienceReactions": true}
}
