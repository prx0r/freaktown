      ],
      "source": "hark-opener",
      "mechanism": "deadpan"
    },
    {
      "id": "l4",
      "beat": 1,
      "role": "setup",
      "text": "A quick question arrives at three in the morning.",
      "delivery": "deliberate",
      "pause_ms": 421,
