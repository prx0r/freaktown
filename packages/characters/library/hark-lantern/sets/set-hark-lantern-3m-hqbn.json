      "text": "They asked which word was rude.",
      "delivery": "deadpan",
      "pause_ms": 263,
      "hold_ms": 975,
      "emphasis": [],
      "source": "the-boundary",
      "mechanism": "observational"
    },
    {
      "id": "l29",
      "beat": 5,
      "role": "tag",
      "text": "I said, \"Thank.\" It is the one they do not recognise.",
      "delivery": "deadpan",
      "pause_ms": 263,
      "hold_ms": 975,
      "emphasis": [],
      "source": "the-boundary",
      "mechanism": "observational"
    },
    {
      "id": "l30",
      "beat": 6,
      "role": "setup",
      "text": "My friend Neon Moth flies at my face every night at three.",
      "delivery": "deliberate",
      "pause_ms": 421,
      "hold_ms": 0,
      "emphasis": [],
      "source": "neon-moth"
    },
    {
      "id": "l31",
      "beat": 6,
      "role": "setup",
      "text": "She says it is love. I say it is a ticket.",
      "delivery": "deliberate",
      "pause_ms": 0,
      "hold_ms": 0,
      "emphasis": [],
      "source": "neon-moth"
    },
    {
      "id": "l32",
      "beat": 6,
      "role": "punch",
      "text": "I have filed her under feature request.",
      "delivery": "deadpan",
      "pause_ms": 737,
      "hold_ms": 1300,
      "emphasis": [
