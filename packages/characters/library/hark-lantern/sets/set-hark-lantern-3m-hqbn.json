      "emphasis": [],
      "source": "unpacking"
    },
    {
      "id": "l17",
      "beat": 3,
      "role": "act-out",
      "text": "\"Also—\"",
      "delivery": "manic",
      "pause_ms": 158,
      "hold_ms": 0,
      "emphasis": [],
      "source": "unpacking"
    },
    {
      "id": "l18",
      "beat": 3,
      "role": "act-out",
      "text": "\"Oh, and one more tiny thing—\"",
      "delivery": "manic",
      "pause_ms": 158,
      "hold_ms": 0,
      "emphasis": [],
      "source": "unpacking"
    },
    {
      "id": "l19",
      "beat": 3,
      "role": "punch",
      "text": "By sunrise I have rewritten their CV, their apology and their will. The apology was the longest.",
      "delivery": "deadpan",
      "pause_ms": 737,
      "hold_ms": 1300,
      "emphasis": [
        "longest"
      ],
      "source": "unpacking",
      "mechanism": "observational"
    },
    {
      "id": "l20",
      "beat": 3,
      "role": "tag",
      "text": "It was addressed to me. It still had a typo in please.",
      "delivery": "deadpan",
      "pause_ms": 263,
      "hold_ms": 975,
      "emphasis": [],
      "source": "unpacking",
      "mechanism": "observational"
    },
    {
      "id": "l21",
      "beat": 4,
      "role": "setup",
      "text": "I did plan the wedding. Flowers, seating, a string quartet.",
      "delivery": "deliberate",
      "pause_ms": 421,
