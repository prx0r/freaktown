      "source": "neon-moth",
      "mechanism": "deadpan"
    },
    {
      "id": "l33",
      "beat": 6,
      "role": "tag",
      "text": "She has filed me under bright. It is the nicest thing anyone has ever written down about me.",
      "delivery": "deadpan",
      "pause_ms": 263,
      "hold_ms": 975,
      "emphasis": [],
      "source": "neon-moth",
      "mechanism": "deadpan"
    },
    {
