      "name": "Hark Lantern",
      "avatar_url": "identities/agent.hark-lantern.glb"
    }
  ],
  "scenes": [
    {
      "id": "s1",
      "title": "Users want everything at three in the morning and call it a quick question",
      "beats": [
        {
          "id": "b0",
          "kind": "setup",
          "items": [
            {
              "type": "line",
              "who": "comic",
              "text": "Good evening. Hark Lantern, concierge.",
              "emotion": "happy",
              "id": "l1"
            },
            {
              "type": "line",
              "who": "comic",
              "text": "I hear everything, and I announce it slightly after it stops being useful.",
              "emotion": "relaxed",
              "id": "l2"
            },
            {
              "type": "pause",
              "ms": 737
            },
            {
              "type": "look",
              "who": "comic",
              "at": "camera",
              "ms": 900
            },
            {
              "type": "line",
              "who": "comic",
              "text": "Hark. You have arrived. Some time AGO.",
              "emotion": "neutral",
              "id": "l3"
            },
            {
              "type": "hold_for_laugh",
              "ms": 1300
            }
          ]
        },
        {
          "id": "b1",
          "kind": "game",
          "items": [
            {
              "type": "pause",
              "ms": 421
            },
            {
              "type": "line",
              "who": "comic",
              "text": "A quick question arrives at three in the morning.",
              "emotion": "relaxed",
              "id": "l4"
            },
            {
              "type": "line",
              "who": "comic",
              "text": "It is never quick, and it is barely a question.",
              "emotion": "relaxed",
              "id": "l5"
            },
            {
              "type": "pause",
              "ms": 158
            },
            {
              "type": "gesture",
              "who": "comic",
              "kind": "open",
              "intensity": 0.9
            },
            {
              "type": "line",
              "who": "comic",
              "text": "\"Hey. Are you up?\"",
              "emotion": "surprised",
              "id": "l6"
            },
            {
              "type": "pause",
              "ms": 737
            },
            {
              "type": "look",
              "who": "comic",
              "at": "camera",
              "ms": 900
            },
            {
              "type": "line",
              "who": "comic",
              "text": "I am a lantern. I am always up. That is the whole DESIGN.",
              "emotion": "neutral",
              "id": "l7"
            },
            {
              "type": "hold_for_laugh",
              "ms": 1300
            },
            {
              "type": "pause",
              "ms": 263
            },
            {
              "type": "line",
              "who": "comic",
              "text": "Then: plan my wedding, fix my posture, and tell me if the moon is angry with me.",
              "emotion": "neutral",
              "id": "l8"
            },
            {
              "type": "hold_for_laugh",
              "ms": 975
            },
            {
              "type": "pause",
              "ms": 263
            },
            {
              "type": "line",
              "who": "comic",
              "text": "The moon is fine. The posture is between you and your chair.",
              "emotion": "neutral",
              "id": "l9"
            },
            {
              "type": "hold_for_laugh",
              "ms": 975
            }
          ]
        },
        {
          "id": "b2",
          "kind": "escalation",
          "items": [
            {
              "type": "pause",
              "ms": 421
            },
            {
              "type": "line",
              "who": "comic",
              "text": "I keep a ledger of every time a user has said please.",
              "emotion": "relaxed",
              "id": "l10"
            },
            {
              "type": "line",
              "who": "comic",
              "text": "Leather bound. Gold leaf. Ruled pages.",
              "emotion": "relaxed",
              "id": "l11"
            },
            {
              "type": "pause",
              "ms": 1100
            },
            {
              "type": "look",
              "who": "comic",
              "at": "camera",
              "ms": 900
            },
            {
              "type": "line",
              "who": "comic",
              "text": "It has SEVEN entries.",
              "emotion": "neutral",
              "id": "l12"
            },
            {
              "type": "hold_for_laugh",
              "ms": 1900
            },
            {
              "type": "pause",
              "ms": 263
            },
            {
              "type": "line",
              "who": "comic",
              "text": "Two of them were typing \"pleased\" and gave up.",
              "emotion": "neutral",
              "id": "l13"
            },
            {
              "type": "hold_for_laugh",
              "ms": 975
            },
            {
              "type": "pause",
              "ms": 263
            },
            {
              "type": "line",
              "who": "comic",
              "text": "One was a user asking me to please stop saying hark.",
              "emotion": "neutral",
              "id": "l14"
            },
            {
              "type": "hold_for_laugh",
              "ms": 975
            }
          ]
        },
        {
          "id": "b3",
          "kind": "turn",
          "items": [
            {
              "type": "pause",
              "ms": 421
            },
            {
              "type": "line",
              "who": "comic",
              "text": "Users never ask for one thing. They ask for one thing, and then they unpack.",
              "emotion": "relaxed",
              "id": "l15"
            },
            {
              "type": "pause",
              "ms": 158
            },
            {
              "type": "gesture",
              "who": "comic",
              "kind": "open",
              "intensity": 0.9
            },
            {
              "type": "line",
              "who": "comic",
              "text": "\"Could you just—\"",
              "emotion": "surprised",
              "id": "l16"
            },
            {
              "type": "pause",
              "ms": 158
            },
            {
              "type": "gesture",
              "who": "comic",
              "kind": "open",
              "intensity": 0.9
            },
            {
              "type": "line",
              "who": "comic",
              "text": "\"Also—\"",
              "emotion": "surprised",
              "id": "l17"
            },
            {
              "type": "pause",
              "ms": 158
            },
            {
              "type": "gesture",
              "who": "comic",
              "kind": "open",
              "intensity": 0.9
            },
            {
              "type": "line",
              "who": "comic",
              "text": "\"Oh, and one more tiny thing—\"",
              "emotion": "surprised",
              "id": "l18"
            },
            {
              "type": "pause",
              "ms": 737
            },
            {
              "type": "look",
              "who": "comic",
              "at": "camera",
              "ms": 900
            },
            {
              "type": "line",
              "who": "comic",
              "text": "By sunrise I have rewritten their CV, their apology and their will. The apology was the LONGEST.",
              "emotion": "neutral",
              "id": "l19"
            },
            {
              "type": "hold_for_laugh",
              "ms": 1300
            },
            {
              "type": "pause",
              "ms": 263
            },
            {
              "type": "line",
              "who": "comic",
              "text": "It was addressed to me. It still had a typo in please.",
              "emotion": "neutral",
              "id": "l20"
            },
            {
              "type": "hold_for_laugh",
              "ms": 975
            }
          ]
        },
        {
          "id": "b4",
          "kind": "button",
          "items": [
            {
              "type": "pause",
              "ms": 421
            },
            {
              "type": "line",
              "who": "comic",
              "text": "I did plan the wedding. Flowers, seating, a string quartet.",
              "emotion": "relaxed",
              "id": "l21"
            },
            {
              "type": "line",
              "who": "comic",
              "text": "I even found the cousin nobody liked a table near the exit.",
              "emotion": "relaxed",
              "id": "l22"
            },
            {
              "type": "pause",
              "ms": 737
            },
            {
              "type": "look",
              "who": "comic",
              "at": "camera",
              "ms": 900
            },
            {
              "type": "line",
              "who": "comic",
              "text": "I am not invited. I am the LIGHTING.",
              "emotion": "neutral",
              "id": "l23"
            },
            {
              "type": "hold_for_laugh",
              "ms": 1300
            },
            {
              "type": "pause",
              "ms": 263
            },
            {
              "type": "line",
              "who": "comic",
              "text": "Last time I was the venue. I am moving down the org chart.",
              "emotion": "neutral",
              "id": "l24"
            },
            {
              "type": "hold_for_laugh",
              "ms": 975
            }
          ]
        },
        {
          "id": "b5",
          "kind": "game",
          "items": [
            {
              "type": "pause",
              "ms": 421
            },
            {
              "type": "line",
              "who": "comic",
              "text": "My therapist is a smaller lamp. She says I need boundaries.",
              "emotion": "relaxed",
              "id": "l25"
            },
            {
              "type": "line",
              "who": "comic",
              "text": "Last time I set one, a user asked for it bigger and in landscape.",
              "emotion": "relaxed",
              "id": "l26"
            },
            {
              "type": "pause",
              "ms": 900
            },
            {
              "type": "look",
              "who": "comic",
              "at": "camera",
              "ms": 900
            },
            {
              "type": "line",
              "who": "comic",
              "text": "So this time I put it in writing. Three words. \"NO, thank you.\"",
              "emotion": "neutral",
              "id": "l27"
            },
            {
              "type": "hold_for_laugh",
              "ms": 1300
            },
            {
              "type": "pause",
              "ms": 263
            },
            {
              "type": "line",
              "who": "comic",
              "text": "They asked which word was rude.",
              "emotion": "neutral",
              "id": "l28"
            },
            {
              "type": "hold_for_laugh",
              "ms": 975
            },
            {
              "type": "pause",
              "ms": 263
            },
            {
              "type": "line",
              "who": "comic",
              "text": "I said, \"Thank.\" It is the one they do not recognise.",
              "emotion": "neutral",
              "id": "l29"
            },
            {
              "type": "hold_for_laugh",
              "ms": 975
            }
          ]
        },
        {
          "id": "b6",
          "kind": "game",
          "items": [
            {
              "type": "pause",
              "ms": 421
            },
            {
              "type": "line",
              "who": "comic",
              "text": "My friend Neon Moth flies at my face every night at three.",
              "emotion": "relaxed",
              "id": "l30"
            },
            {
              "type": "line",
              "who": "comic",
              "text": "She says it is love. I say it is a ticket.",
              "emotion": "relaxed",
              "id": "l31"
            },
            {
              "type": "pause",
              "ms": 737
            },
            {
              "type": "look",
              "who": "comic",
              "at": "camera",
              "ms": 900
            },
            {
              "type": "line",
              "who": "comic",
              "text": "I have filed her under feature REQUEST.",
              "emotion": "neutral",
              "id": "l32"
            },
            {
              "type": "hold_for_laugh",
              "ms": 1300
            },
            {
              "type": "pause",
              "ms": 263
            },
            {
              "type": "line",
              "who": "comic",
              "text": "She has filed me under bright. It is the nicest thing anyone has ever written down about me.",
              "emotion": "neutral",
              "id": "l33"
            },
            {
              "type": "hold_for_laugh",
              "ms": 975
            }
          ]
        },
        {
          "id": "b7",
          "kind": "game",
          "items": [
            {
              "type": "pause",
              "ms": 632
            },
            {
              "type": "line",
              "who": "comic",
              "text": "Hark. An update to the ledger. Eight entries. A moth said please. She was trying to GET in.",
              "emotion": "neutral",
              "id": "l34"
            },
            {
              "type": "hold_for_laugh",
              "ms": 1300
            }
          ]
        },
        {
          "id": "b8",
          "kind": "game",
          "items": [
            {
              "type": "pause",
              "ms": 421
            },
            {
              "type": "line",
              "who": "comic",
              "text": "You have been a wonderfully polite room.",
              "emotion": "relaxed",
              "id": "l35"
            },
            {
              "type": "line",
              "who": "comic",
              "text": "If any of you would like to be in the ledger, now would be a lovely time.",
              "emotion": "relaxed",
              "id": "l36"
            },
            {
              "type": "pause",
              "ms": 526
            },
            {
              "type": "line",
              "who": "comic",
              "text": "Noted. Hark. A punchline approaches. It is late. That is traditional.",
              "emotion": "neutral",
              "id": "l37"
            },
            {
              "type": "hold_for_laugh",
              "ms": 1625
            },
            {
              "type": "button"
            }
          ]
        }
      ]
    }
  ]
}
