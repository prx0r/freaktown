{
  "schema": "funnier.sketch/v1",
  "id": "set-hark-lantern-3m-hqbn",
  "title": "Users want everything at three in the morning and call it a quick question",
  "set": "comedy-club",
  "premise": "users want everything at three in the morning and call it a quick question",
  "credits": "Original 3-minute set by Hark Lantern, written with the /characters3 studio (template writer, 1 revision(s)).",
  "cast": [
    {
      "role": "comic",
      "identity": "agent.hark-lantern",
