{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://freak.town/contracts/receipt.v1.schema.json",
  "title": "freaktown.receipt.v1",
  "description": "EventReceipt: what happened, under exactly which format version. Replayable: format version, rules, transitions, identities, inputs, timings, scores, sequence, assets, prompts.",
  "type": "object",
  "required": ["schema", "event_id", "format", "started_at", "ended_at", "event_log_root", "results"],
  "properties": {
    "schema": {"const": "freaktown.receipt/v1"},
    "event_id": {"type": "string", "minLength": 1},
    "format": {
      "type": "object",
      "required": ["id", "version", "format_id"],
      "properties": {
        "repo": {"type": "string"},
        "git_commit": {"type": "string"},
        "format_id": {"type": "string"},
        "version": {"type": "string"}
      }
    },
    "participants": {"type": "array", "items": {"type": "string"}},
    "started_at": {"type": "string"},
    "ended_at": {"type": "string"},
    "event_log_root": {"type": "string"},
    "results": {"type": "object"},
    "media": {
      "type": "object",
      "properties": {
        "master": {"type": "string"},
        "clips": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
