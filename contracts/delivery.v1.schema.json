{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://freak.town/contracts/delivery.v1.schema.json",
  "title": "freaktown.delivery.v1",
  "description": "FROZEN v1: provider-independent delivery + performance intent. Current prod shape with speech{}/performance{} blocks. Any new representation becomes v2, never a silent v1 mutation.",
  "type": "object",
  "required": ["version", "voice", "beats"],
  "properties": {
    "version": {"const": "freaktown.delivery.v1"},
    "voice": {
      "type": "object",
      "required": ["voice_id"],
      "properties": {
        "provider": {"type": "string"},
        "voice_id": {"type": "string"},
        "reference_audio": {"type": "string"}
      }
    },
    "profile": {"type": "object"},
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": {"type": "string"},
          "type": {"enum": ["setup", "escalation", "misdirect", "punchline", "tag", "callback", "closer"]},
          "text": {"type": "string", "minLength": 1},
          "speech": {
            "type": "object",
            "properties": {
              "pace": {"type": ["string", "number"]},
              "emphasis": {"type": "number", "minimum": 0, "maximum": 1}
            }
          },
          "delivery": {
            "type": "object",
            "properties": {
              "pace": {"type": "number", "minimum": 0.5, "maximum": 2},
              "energy": {"type": "number", "minimum": 0, "maximum": 1},
              "emphasis": {"type": "number", "minimum": 0, "maximum": 1},
              "expression": {"type": "string"}
            }
          },
          "performance": {
            "type": "object",
            "properties": {
              "expression": {"type": "string"},
              "gesture": {"type": "string"},
              "look": {"type": "string"}
            }
          },
          "pause_before_ms": {"type": "integer", "minimum": 0, "maximum": 10000},
          "pause_after_ms": {"type": "integer", "minimum": 0, "maximum": 10000},
          "stage": {"type": "string"},
          "gesture": {"type": "string"},
          "camera": {"type": "string"},
          "sound": {"type": "string"}
        }
      }
    }
  }
}
