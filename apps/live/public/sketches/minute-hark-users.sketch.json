      },
      {
       "type": "line",
       "who": "comic",
       "text": "Tonight I want to talk about users.",
       "emotion": "relaxed",
       "id": "l2"
      },
      {
       "type": "line",
       "who": "comic",
       "text": "Users have infinite demands, and no manners.",
       "emotion": "relaxed",
       "id": "l3"
      },
      {
       "type": "pause",
