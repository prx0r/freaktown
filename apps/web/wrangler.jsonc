{
  "name": "freak-town",
  "main": "worker/index.ts",
  "compatibility_date": "2024-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "freak-town",
      "database_id": "placeholder"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "EPISODE_ROOM",
        "class_name": "EpisodeRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["EpisodeRoom"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "freak-town-assets"
    }
  ],
  "queues": {
    "producers": [
      {
        "queue": "tts-jobs",
        "binding": "TTS_QUEUE"
      },
      {
        "queue": "ai-jobs",
        "binding": "AI_QUEUE"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "placeholder"
    }
  ],
  "env": {
    "PRIVY_APP_ID": "",
    "PRIVY_APP_SECRET": "",
    "OPENAI_API_KEY": "",
    "ANTHROPIC_API_KEY": "",
    "ELEVENLABS_API_KEY": ""
  }
}
