# LLM (Ella needs this for live reactions)
OPENAI_API_KEY=sk-...

# OpenCode Go (director + live staging via mimo-v2.5 ONLY — no other model
# on this key). Correct endpoint (NOT OpenRouter, NOT zen/go for chat):
# base https://opencode.ai/inference/go/openai/v1 + /chat/completions,
# model mimo-v2.5, headers x-opencode-session (stable id) + own User-Agent.
# OPENCODE_GO_API_KEY=oc_sk-...
# OPENCODE_GO_MODEL=mimo-v2.5

# Qwen Omni (Aliyun Model Studio Singapore — party bot brains behind
# PARTY_PI_AGENTS=1; scripts/party_pi_agents.py reads these from .env).
# Model pinned per call via QWEN_MODEL. NEVER put the real key here, in chat,
# or in tree — freaktown/.env (600, gitignored) only. A pasted key must be
# treated as exposed and rotated in the Model Studio console.
# QWEN_API_KEY goes in freaktown/.env only — never here, never in chat.
# QWEN_BASE_URL=https://YOUR-WORKSPACE.ap-southeast-1.maas.aliyuncs.com
# QWEN_MODEL=qwen3.8-omni-flash
# Optional agent order: auto (qwen first, then pi) | qwen | pi.
# PARTY_PI_AGENTS=1
# PARTY_PI_BACKEND=auto

# Marble Atlas (World Labs — Cauldron venue builds. Owner holds beta access.
# NEVER paste the real key here or in chat. Live calls are ask-first ($0 rule:
# ~$1.26 text→world + ~$2.80 HQ mesh export). Script: scripts/marble_cauldron.py
# reads WLT_API_KEY from the environment only, --live flag required.)
# WLT_API_KEY=wlt-...

# TTS (optional — works without, just skips audio files)
# TTS_VOICE=en-US-GuyNeural
# TTS_VOICE_ELLA=en-US-AriaNeural

# Proactive table talk (party_chatter.py) + live bot brains (party_pi_agents).
# Real values live in freaktown/.env ONLY (600, gitignored). Tests never
# load .env — keep it that way (deterministic + no network in CI).
# PARTY_CHATTER=1
# PARTY_PI_AGENTS=1
# PARTY_CHATTER_GAP=6
# QWEN_MODEL=qwen-flash-character
