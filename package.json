{
  "name": "funnier-ts",
  "private": true,
  "description": "TS workspace: contracts + stage-runtime + apps/live (live stage). Python stays the product shell.",
  "workspaces": [
    "packages/contracts",
    "packages/stage-runtime",
    "packages/newsroom",
    "packages/sketch",
    "packages/party",
    "packages/characters",
    "apps/live"
  ],
  "scripts": {
    "build": "npm run typecheck && npm run build -w @funnier/live",
    "typecheck": "tsc -p packages/contracts && tsc -p packages/stage-runtime && tsc -p packages/newsroom && tsc -p packages/sketch && tsc -p packages/party && tsc -p packages/characters && tsc -p apps/live --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run test:e2e -w @funnier/live",
    "dev": "npm run dev -w @funnier/live",
    "newsroom:render": "node packages/newsroom/cli/render.mjs",
    "sketch:render": "node packages/sketch/cli/render.mjs",
    "sketch:stats": "python3 packages/sketch/scripts/snl_structure_stats.py",
    "sketch:identities": "node packages/sketch/scripts/build-identities.mjs",
    "party:rooms": "vite-node packages/party/server/rooms-server.ts",
    "party:identity": "node packages/party/cli/create-identity.mjs",
    "characters:mcp": "vite-node packages/characters/bin/characters-mcp.ts",
    "characters:mcp:http": "vite-node packages/characters/bin/characters-mcp.ts -- --http"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
