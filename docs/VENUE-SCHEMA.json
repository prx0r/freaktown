{
  "$schema": "freaktown.venue.v1",
  "$comment": "Every venue validates against this before it loads. Sizes S/M/L bound dims, capacity, parses, GLB weight. Props must exist in the registry (docs/VENUE-PROPS.md). Lights are rigs, not vibes: temp/intensity/position or it doesn't ship.",
  "required": ["id", "name", "size", "room", "stage", "marks", "props",
               "light_rig", "cameras", "crowd", "budgets", "glb",
               "acoustics", "physics"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]{2,32}$"},
    "name": {"type": "string", "minLength": 2, "maxLength": 40},
    "size": {"enum": ["S", "M", "L"]},
    "room": {"type": "object", "required": ["w", "d", "h"],
              "props_notes": "meters, Y-up, origin at stage front-center",
              "properties": {
                "w": {"type": "number", "min": 4, "max": 40},
                "d": {"type": "number", "min": 4, "max": 40},
                "h": {"type": "number", "min": 2.4, "max": 12}}},
    "stage": {"type": "object", "required": ["w", "d", "top_y", "front_z", "back_z"],
              "properties": {
                "w": {"type": "number", "min": 2, "max": 20},
                "d": {"type": "number", "min": 1.5, "max": 12},
                "top_y": {"type": "number", "min": 0, "max": 2},
                "front_z": {"type": "number"}, "back_z": {"type": "number"}}},
    "marks": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["id", "pos", "facing"],
      "properties": {
        "id": {"type": "string"},
        "pos": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
        "facing": {"type": "string", "pattern": "^[+-][XYZ]$"}}}},
    "props": {"type": "array", "items": {
      "type": "object", "required": ["id", "anchor", "pack"],
      "properties": {
        "id": {"type": "string", "comment": "must exist in VENUE-PROPS registry"},
        "anchor": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
        "pack": {"enum": ["base", "band", "judging", "custom"]},
        "variant": {"type": "string", "maxLength": 24, "comment": "per-venue material/finish, e.g. brass-worn. Zero downloads."},
        "mesh": {"type": "string", "maxLength": 120, "comment": "optional Atlas/custom GLB overriding procedural. Empty = procedural."}}}},
    "light_rig": {"type": "object", "required": ["house", "spot"],
      "properties": {
        "house": {"$ref": "#/definitions/light"},
        "spot": {"$ref": "#/definitions/light"},
        "washes": {"type": "array", "maxItems": 4, "items": {"$ref": "#/definitions/light"}},
        "practicals": {"type": "array", "items": {"type": "string"}}}},
    "cameras": {"type": "array", "minItems": 1, "maxItems": 8, "items": {
      "type": "object", "required": ["id", "pos", "fov"],
      "properties": {
        "id": {"type": "string"},
        "pos": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
        "fov": {"type": "number", "min": 15, "max": 70}}}},
    "crowd": {"type": "object", "required": ["capacity", "zones"],
      "properties": {
        "capacity": {"type": "integer", "min": 2, "max": 2000},
        "zones": {"type": "array", "minItems": 1, "items": {
          "type": "object", "required": ["id", "tier", "count"],
          "properties": {
            "id": {"type": "string"},
            "tier": {"enum": ["face", "pip"]},
            "count": {"type": "integer", "min": 1}}}}}},
    "budgets": {"type": "object", "required": ["glb_mb", "parses"],
      "properties": {
        "glb_mb": {"type": "number", "min": 1, "max": 200},
        "parses": {"type": "integer", "min": 1, "max": 12}}},
    "acoustics": {"type": "object", "required": ["rt60", "warmth", "bed_db"],
      "comment": "room sound: reverb time, low-end warmth 0..1, crowd bed gain",
      "properties": {
        "rt60": {"type": "number", "min": 0.2, "max": 3.0},
        "warmth": {"type": "number", "min": 0, "max": 1},
        "bed_db": {"type": "number", "min": -24, "max": 0}}},
    "physics": {"type": "object", "required": ["decay", "laugh_gain", "resist_start"],
      "comment": "crowd dynamics: per-event heat decay, heat per laugh (cap 1.0), starting resistance",
      "properties": {
        "decay": {"type": "number", "min": 0.5, "max": 0.99},
        "laugh_gain": {"type": "number", "min": 0.02, "max": 0.5},
        "resist_start": {"type": "number", "min": 0, "max": 1}}},
    "glb": {"type": "object", "required": ["sha256"],
      "properties": {"sha256": {"type": "string", "minLength": 8}}}
  },
  "definitions": {
    "light": {"type": "object", "required": ["temp_k", "level", "pos"],
      "properties": {
        "temp_k": {"type": "number", "min": 1800, "max": 8000},
        "level": {"type": "number", "min": 0, "max": 1},
        "pos": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}}}
  },
  "sizes": {
    "S": {"room": "≤12×9×4.0m", "capacity": "≤60", "parses": 3, "glb_mb": 30,
          "note": "cellar/studio. Cauldron lives here."},
    "M": {"room": "≤20×16×6m", "capacity": "≤250", "parses": 5, "glb_mb": 80,
          "note": "hall. Judging panel fits; band kit fits."},
    "L": {"room": "≤40×30×12m", "capacity": "≤2000", "parses": 8, "glb_mb": 200,
          "note": "theatre. Impostor crowd required beyond 60 faces."}
  }
}
